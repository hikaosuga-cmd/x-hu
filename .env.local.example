# Supabase の設定値（Supabase ダッシュボード > Settings > API からコピー）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# GitHub Pages のデプロイ先リポジトリ名（例: /x-hu）
# GitHub Pages でリポジトリのサブパスにデプロイする場合のみ設定
NEXT_PUBLIC_BASE_PATH=/x-hu
